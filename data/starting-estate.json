    {
      "id": "steward",
      "name": "Aldric",
      "role": "steward",
      "location": "fontenay",
      "notes": "Long-serving steward of Fontenay. The villa is thin: few households, much waste and scrub, a short chest. Speaks plainly, counts carefully, distrusts novelties until they work twice."
    },
    {
      "id": "smith",
      "name": "Bernard",
      "role": "smith",
      "location": "fontenay",
      "notes": "Estate smith at a timber forge short of iron and charcoal. Knows bloom iron, shoes, tools, and nails. Will not pretend to rule the fields."
    },
