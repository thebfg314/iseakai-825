{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local/cn-iseakai/world-state.schema.json",
  "title": "CarolingianEstateWorldState",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "meta",
    "player",
    "holdings",
    "resources",
    "custom_resources",
    "population",
    "labour",
    "market",
    "projects",
    "modifiers",
    "standing_orders",
    "npcs",
    "known_techniques",
    "flags",
    "trade",
    "merchant"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["year", "season", "turn", "region"],
      "properties": {
        "year": { "type": "integer" },
        "season": { "enum": ["spring", "summer", "autumn", "winter"] },
        "turn": { "type": "integer", "minimum": 1 },
        "region": { "type": "string" },
        "eraNote": { "type": "string" }
      }
    },
    "player": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "rank"],
      "properties": {
        "name": { "type": "string" },
        "rank": { "enum": ["minor_noble"] }
      }
    },
    "holdings": {
      "type": "array",
      "items": { "$ref": "#/$defs/holding" }
    },
    "resources": { "$ref": "#/$defs/resourceMap" },
    "custom_resources": {
      "type": "array",
      "items": { "$ref": "#/$defs/customResource" }
    },
    "population": {
      "type": "object",
      "additionalProperties": false,
      "required": ["households", "adult_men", "adult_women", "youths"],
      "properties": {
        "households": { "type": "integer", "minimum": 0 },
        "adult_men": { "type": "integer", "minimum": 0 },
        "adult_women": { "type": "integer", "minimum": 0 },
        "youths": { "type": "integer", "minimum": 0 },
        "mancipia": { "type": "integer", "minimum": 0 }
      }
    },
    "labour": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assigned", "harvest_risk"],
      "properties": {
        "assigned": {
          "type": "array",
          "items": { "$ref": "#/$defs/labourAssignment" }
        },
        "harvest_risk": { "type": "boolean" }
      }
    },
    "market": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/priceRange" }
    },
    "projects": {
      "type": "array",
      "items": { "$ref": "#/$defs/project" }
    },
    "modifiers": {
      "type": "array",
      "items": { "$ref": "#/$defs/modifier" }
    },
    "standing_orders": {
      "type": "array",
      "items": { "$ref": "#/$defs/standingOrder" }
    },
    "npcs": {
      "type": "array",
      "items": { "$ref": "#/$defs/npc" }
    },
    "known_techniques": {
      "type": "array",
      "items": { "$ref": "#/$defs/technique" }
    },
    "flags": {
      "type": "object",
      "additionalProperties": false,
      "required": ["merchant_present", "active_threat", "monastery_nearby", "hunger"],
      "properties": {
        "merchant_present": { "type": "boolean" },
        "active_threat": { "type": "boolean" },
        "monastery_nearby": { "type": "boolean" },
        "hunger": { "type": "boolean" },
        "regional_famine": {
          "type": "boolean",
          "default": false,
          "description": "Pagus-wide dearth. Events may set this later. False means hunger, if any, is this villa's own."
        }
      }
    },
    "trade": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "major_river": { "type": "boolean" },
        "major_road": { "type": "boolean" },
        "known_surplus": { "type": "boolean" },
        "remote": { "type": "boolean" }
      }
    },
    "merchant": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "present": { "type": "boolean" },
        "name": { "type": "string" },
        "face": { "type": "integer", "minimum": 1, "maximum": 8 },
        "last_chance": { "type": "number" },
        "stock": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["resource", "amount"],
            "properties": {
              "resource": { "type": "string" },
              "amount": { "type": "number" }
            }
          }
        },
        "purse": { "type": "number", "minimum": 0 },
        "purseStart": { "type": "number", "minimum": 0 },
        "demand": { "type": "number", "minimum": 0, "maximum": 1 },
        "buyback": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["resource", "amount", "pricePerUnit"],
            "properties": {
              "resource": { "type": "string" },
              "amount": { "type": "number" },
              "pricePerUnit": { "type": "number" }
            }
          }
        },
        "boughtVolume": {
          "type": "object",
          "additionalProperties": { "type": "number" }
        },
        "soldVolume": {
          "type": "object",
          "additionalProperties": { "type": "number" }
        },
        "purseDrained": { "type": "boolean" }
      }
    },
    "merchant_memories": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "$ref": "#/$defs/npcMemory" }
      }
    },
    "merchant_intro_spoken": {
      "type": "object",
      "additionalProperties": { "type": "boolean" },
      "description": "First-meeting intro already shown for a visiting merchant, keyed by visitor name."
    },
    "merchant_purse_bonus": {
      "type": "object",
      "additionalProperties": { "type": "number" },
      "description": "Extra buying power on the next visit after a drained purse, keyed by visitor name."
    },
    "agriculture": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "springBarleyShare": { "type": "number", "minimum": 0, "maximum": 1 },
        "autumnWheatShare": { "type": "number", "minimum": 0, "maximum": 1 },
        "rotation": { "enum": ["two_field", "three_field"] }
      }
    },
    "last_season_deltas": {
      "type": "object",
      "additionalProperties": { "type": "number" },
      "description": "Signed store, sown, and household changes from the last resolved season. Empty until the first Advance season."
    },
    "peopleHappiness": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "default": 50,
      "description": "Estate-wide people's happiness (0 wretched … 100 joyful). Source of truth for morale. Mood modifiers nudge this meter; they do not scale yield or callable labour. Omitted on old saves; treat as 50."
    },
    "peopleHappinessHighStreak": {
      "type": "integer",
      "minimum": 0,
      "default": 0,
      "description": "Consecutive Advance seasons the people have been joyful (≥75). Omitted on old saves; treat as 0."
    },
    "peopleHappinessLowStreak": {
      "type": "integer",
      "minimum": 0,
      "default": 0,
      "description": "Consecutive Advance seasons the people have been wretched (≤24). Omitted on old saves; treat as 0."
    },
    "estateAbandoned": {
      "type": "boolean",
      "default": false,
      "description": "True when the demesne people are gone and the villa cannot be worked. Omitted on old saves; treat as false."
    },
    "estate_history": {
      "type": "array",
      "items": { "$ref": "#/$defs/estateSeasonSnapshot" },
      "description": "Prior seasons' estate books as they stood before each Advance season. Empty until the first Advance season."
    },
    "forthcoming_orders": {
      "type": "array",
      "items": { "$ref": "#/$defs/forthcomingOrder" },
      "description": "Confirmed mechanical changes waiting on a later harvest or sowing beat. Omitted on old saves; treat as empty."
    },
    "church": {
      "$ref": "#/$defs/churchState",
      "description": "Cell of Saint-Martin: sponsored feasts, neglect, the bishop's letters, hunger alms, and surplus sold this season. Omitted on old saves; treat as a quiet cell."
    }
  },
  "$defs": {
    "season": { "enum": ["spring", "summer", "autumn", "winter"] },
    "priceRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max"],
      "properties": {
        "min": { "type": "number" },
        "max": { "type": "number" }
      }
    },
    "resourceMap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "denarii",
        "wheat",
        "rye",
        "barley",
        "oats",
        "cattle",
        "sheep",
        "pigs",
        "horses",
        "poultry",
        "bees",
        "wine",
        "cheese",
        "honey",
        "wool",
        "linen",
        "softwood",
        "hardwood",
        "charcoal",
        "iron",
        "copper",
        "tin",
        "salt",
        "stone",
        "hides",
        "beeswax",
        "trade_goods"
      ],
      "properties": {
        "denarii": { "type": "number" },
        "wheat": { "type": "number" },
        "rye": { "type": "number" },
        "barley": { "type": "number" },
        "oats": { "type": "number" },
        "cattle": { "type": "number" },
        "sheep": { "type": "number" },
        "pigs": { "type": "number" },
        "horses": { "type": "number" },
        "poultry": { "type": "number" },
        "bees": { "type": "number" },
        "wine": { "type": "number" },
        "cheese": { "type": "number" },
        "honey": { "type": "number" },
        "wool": { "type": "number" },
        "linen": { "type": "number" },
        "softwood": { "type": "number" },
        "hardwood": { "type": "number" },
        "charcoal": { "type": "number" },
        "iron": { "type": "number" },
        "copper": { "type": "number" },
        "tin": { "type": "number" },
        "salt": { "type": "number" },
        "stone": { "type": "number" },
        "hides": { "type": "number" },
        "beeswax": { "type": "number" },
        "trade_goods": { "type": "number" }
      }
    },
    "holding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "land", "sown", "households", "features"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "land": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fertile_arable",
            "meadow",
            "vineyard",
            "orchard",
            "woodland",
            "scrub",
            "waste",
            "swamp"
          ],
          "properties": {
            "fertile_arable": { "type": "number" },
            "meadow": { "type": "number" },
            "vineyard": { "type": "number" },
            "orchard": { "type": "number" },
            "woodland": { "type": "number" },
            "scrub": { "type": "number" },
            "waste": { "type": "number" },
            "swamp": { "type": "number" }
          }
        },
        "sown": {
          "type": "object",
          "additionalProperties": false,
          "required": ["wheat", "rye", "barley", "oats"],
          "properties": {
            "wheat": { "type": "number" },
            "rye": { "type": "number" },
            "barley": { "type": "number" },
            "oats": { "type": "number" }
          }
        },
        "households": { "type": "integer", "minimum": 0 },
        "features": { "type": "array", "items": { "type": "string" } }
      }
    },
    "customResource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "unit", "amount", "priceMin", "priceMax"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "unit": { "type": "string" },
        "amount": { "type": "number" },
        "priceMin": { "type": "number" },
        "priceMax": { "type": "number" },
        "notes": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } }
      }
    },
    "labourAssignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectId", "men", "women", "youths"],
      "properties": {
        "projectId": { "type": "string" },
        "men": { "type": "number" },
        "women": { "type": "number" },
        "youths": { "type": "number" }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "key",
        "name",
        "holdingId",
        "labourDaysRequired",
        "labourDaysDone",
        "materials",
        "materialsReserved",
        "status"
      ],
      "properties": {
        "id": { "type": "string" },
        "key": { "type": "string" },
        "name": { "type": "string" },
        "holdingId": { "type": "string" },
        "labourDaysRequired": { "type": "number" },
        "labourDaysDone": { "type": "number" },
        "materials": {
          "type": "object",
          "additionalProperties": false,
          "required": ["lumber", "iron", "stone"],
          "properties": {
            "lumber": { "type": "number" },
            "iron": { "type": "number" },
            "stone": { "type": "number" },
            "charcoal": { "type": "number" },
            "clay": { "type": "number" }
          }
        },
        "materialsReserved": { "type": "boolean" },
        "status": { "enum": ["active", "completed", "cancelled"] },
        "rush": { "type": "boolean" },
        "tag": { "type": "string" },
        "notes": { "type": "string" },
        "startedYear": { "type": "integer" },
        "startedSeason": { "$ref": "#/$defs/season" },
        "completedYear": { "type": "integer" },
        "completedSeason": { "$ref": "#/$defs/season" },
        "seasonMarks": {
          "type": "array",
          "items": { "$ref": "#/$defs/projectSeasonMark" }
        },
        "hunt": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "goods",
            "resource",
            "amount",
            "quotedDenarii",
            "escrowedDenarii",
            "durationSeasons",
            "seasonsElapsed"
          ],
          "properties": {
            "goods": { "type": "string" },
            "resource": { "type": "string" },
            "amount": { "type": "number" },
            "quotedDenarii": { "type": "number" },
            "escrowedDenarii": { "type": "number" },
            "durationSeasons": { "type": "integer" },
            "seasonsElapsed": { "type": "integer" },
            "riskNote": { "type": "string" },
            "unit": { "type": "string" },
            "customName": { "type": "string" },
            "customUnit": { "type": "string" },
            "priceMin": { "type": "number" },
            "priceMax": { "type": "number" },
            "tags": { "type": "array", "items": { "type": "string" } },
            "customNotes": { "type": "string" },
            "reportSpeech": { "type": "string" },
            "reportEmotion": { "type": "string" },
            "reported": { "type": "boolean" }
          }
        },
        "smithing": {
          "type": "object",
          "additionalProperties": false,
          "required": ["durationSeasons", "seasonsElapsed"],
          "properties": {
            "durationSeasons": { "type": "integer" },
            "seasonsElapsed": { "type": "integer" }
          }
        }
      }
    },
    "projectSeasonMark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["year", "season", "labourDaysDone"],
      "properties": {
        "year": { "type": "integer" },
        "season": { "$ref": "#/$defs/season" },
        "labourDaysDone": { "type": "number" },
        "huntSeasonsElapsed": { "type": "integer" },
        "smithingSeasonsElapsed": { "type": "integer" }
      }
    },
    "estateSeasonSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "year",
        "season",
        "turn",
        "region",
        "holdings",
        "resources",
        "custom_resources",
        "population",
        "agriculture",
        "flags",
        "merchant",
        "market",
        "npcs",
        "known_techniques"
      ],
      "properties": {
        "year": { "type": "integer" },
        "season": { "$ref": "#/$defs/season" },
        "turn": { "type": "integer" },
        "region": { "type": "string" },
        "holdings": { "type": "array", "items": { "$ref": "#/$defs/holding" } },
        "resources": { "$ref": "#/$defs/resourceMap" },
        "custom_resources": { "type": "array", "items": { "$ref": "#/$defs/customResource" } },
        "population": {
          "type": "object",
          "additionalProperties": false,
          "required": ["households", "adult_men", "adult_women", "youths"],
          "properties": {
            "households": { "type": "integer", "minimum": 0 },
            "adult_men": { "type": "integer", "minimum": 0 },
            "adult_women": { "type": "integer", "minimum": 0 },
            "youths": { "type": "integer", "minimum": 0 },
            "mancipia": { "type": "integer", "minimum": 0 }
          }
        },
        "agriculture": {
          "type": "object",
          "additionalProperties": false,
          "required": ["springBarleyShare", "autumnWheatShare"],
          "properties": {
            "springBarleyShare": { "type": "number" },
            "autumnWheatShare": { "type": "number" },
            "rotation": { "enum": ["two_field", "three_field"] }
          }
        },
        "last_season_deltas": {
          "type": "object",
          "additionalProperties": { "type": "number" }
        },
        "flags": {
          "type": "object",
          "additionalProperties": false,
          "required": ["merchant_present", "hunger"],
          "properties": {
            "merchant_present": { "type": "boolean" },
            "hunger": { "type": "boolean" }
          }
        },
        "merchant": {
          "type": "object",
          "additionalProperties": false,
          "required": ["present"],
          "properties": {
            "present": { "type": "boolean" },
            "name": { "type": "string" },
            "stock": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["resource", "amount"],
                "properties": {
                  "resource": { "type": "string" },
                  "amount": { "type": "number" }
                }
              }
            }
          }
        },
        "market": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/priceRange" }
        },
        "npcs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "role"],
            "properties": {
              "name": { "type": "string" },
              "role": { "type": "string" }
            }
          }
        },
        "known_techniques": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name"],
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" }
            }
          }
        },
        "labour": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pool", "remaining"],
          "properties": {
            "pool": { "$ref": "#/$defs/labourPoolView" },
            "remaining": { "$ref": "#/$defs/labourPoolView" }
          }
        }
      }
    },
    "labourPoolView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["men", "women", "youths"],
      "properties": {
        "men": { "type": "number" },
        "women": { "type": "number" },
        "youths": { "type": "number" }
      }
    },
    "modifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "target", "kind", "effect", "source"],
      "properties": {
        "id": { "type": "string" },
        "target": {
          "enum": [
            "grain_yield",
            "labour_efficiency",
            "spoilage",
            "project_speed",
            "specific_resource_output",
            "accident_risk",
            "mood",
            "market_price",
            "livestock_yield",
            "harvest_risk",
            "custom"
          ]
        },
        "kind": { "enum": ["temporary", "permanent"] },
        "seasons_remaining": { "type": ["integer", "null"] },
        "promote_on_expire": { "type": "boolean" },
        "effect": {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "value"],
          "properties": {
            "op": { "enum": ["multiply", "add", "set"] },
            "value": { "type": "number" }
          }
        },
        "source": { "type": "string" },
        "risks": { "type": "array", "items": { "type": "string" } },
        "holdingId": { "type": "string" },
        "resourceId": { "type": "string" },
        "customNote": { "type": "string" }
      }
    },
    "standingOrder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "active"],
      "properties": {
        "id": { "type": "string" },
        "text": { "type": "string" },
        "active": { "type": "boolean" }
      }
    },
    "churchState": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "feastHeldKey": { "type": "string" },
        "feastFade": { "type": "integer", "minimum": 0 },
        "neglect": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["turn", "year", "season", "kind", "note"],
            "properties": {
              "turn": { "type": "integer" },
              "year": { "type": "integer" },
              "season": { "$ref": "#/$defs/season" },
              "kind": { "enum": ["tithe", "wool", "sheep", "sunday", "feast_day", "took_from_cell"] },
              "note": { "type": "string" }
            }
          }
        },
        "bishopLetterTurn": { "type": ["integer", "null"] },
        "letters": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "year", "season", "turn", "text"],
            "properties": {
              "id": { "type": "string" },
              "year": { "type": "integer" },
              "season": { "$ref": "#/$defs/season" },
              "turn": { "type": "integer" },
              "text": { "type": "string" }
            }
          }
        },
        "reputation": { "type": "string" },
        "almsTurn": { "type": ["integer", "null"] },
        "surplusSeasonKey": { "type": "string" },
        "surplusSold": { "type": "object", "additionalProperties": { "type": "number" } }
      }
    },
    "forthcomingOrder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "npcId", "text", "proposal", "status"],
      "properties": {
        "id": { "type": "string" },
        "npcId": { "type": "string" },
        "text": { "type": "string" },
        "beat": { "enum": ["after_harvest", "next_spring_sowing", "next_autumn_sowing"] },
        "seasonsRemaining": { "type": "integer", "minimum": 0 },
        "proposal": { "type": "object" },
        "status": { "enum": ["waiting", "applied", "cancelled", "rejected"] },
        "createdTurn": { "type": "integer" },
        "createdSeason": { "enum": ["spring", "summer", "autumn", "winter"] },
        "createdYear": { "type": "integer" }
      }
    },
    "npcMemory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["turn", "year", "season", "summary"],
      "properties": {
        "turn": { "type": "integer" },
        "year": { "type": "integer" },
        "season": { "enum": ["spring", "summer", "autumn", "winter"] },
        "summary": { "type": "string" }
      }
    },
    "npc": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "role", "location"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "location": { "type": "string" },
        "notes": { "type": "string" },
        "memories": {
          "type": "array",
          "items": { "$ref": "#/$defs/npcMemory" }
        },
        "introSpoken": { "type": "boolean" },
        "wantsTalk": { "type": "boolean" }
      }
    },
    "technique": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "discoveredTurn"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "discoveredTurn": { "type": "integer" },
        "notes": { "type": "string" }
      }
    }
  }
}
